# Copy this file to .env and fill in what you use. Everything is optional except
# where noted; the app works with no keys at all (console + file alerts only).
# Keep notes on their own lines: Docker Compose passes anything after a value through as
# part of the value, comment or not.

# --- storage -----------------------------------------------------------------
# DuckDB market data + SQLite app DB live here
DSE_DATA_DIR=./data
# cap for small servers, e.g. 400MB on a 1 GB VM; blank = DuckDB default
DSE_DUCKDB_MEMORY=
# 0 = all cores
DSE_DUCKDB_THREADS=0

# --- email delivery (optional; leave blank to keep alerts in the console/outbox) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# e.g. yourname@gmail.com
SMTP_USER=
# Gmail "App password" (not your login password)
SMTP_PASSWORD=
# usually the same as SMTP_USER
ALERT_FROM=
# default recipient; users can override in the UI
ALERT_TO=

# --- Telegram (optional) -----------------------------------------------------
# @BotFather -> /newbot -> token. Message your bot once, then `dse alerts telegram-id`.
TELEGRAM_BOT_TOKEN=
# default chat; users can set their own in the web UI
TELEGRAM_CHAT_ID=

# --- AI summary (optional) ---------------------------------------------------
# An ordered chain; the first provider that is configured and answers writes the summary.
# Leave every key blank and the feature is off. Names: groq, openrouter, anthropic, openai_compatible.
AI_PROVIDERS=groq,openrouter,anthropic
# console.groq.com (free tier)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# openrouter.ai/keys (free models end in :free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# console.anthropic.com (paid)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-fable-5-1
# Any other OpenAI-compatible endpoint, e.g. a local Ollama (add "openai_compatible" to AI_PROVIDERS)
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=llama3.1

# --- web app -----------------------------------------------------------------
# any long random string; blank = a random key per start (sessions
APP_SECRET_KEY=
# end on every restart), so set one on a server
APP_HOST=127.0.0.1
APP_PORT=8000
# e.g. https://dse-alerts.fly.dev when hosted; used in emails
APP_PUBLIC_URL=
# en | bn; visitors and users can switch in the header
APP_DEFAULT_LANG=en
# 1 on a public instance: "Try the demo" logs into the shared
APP_DEMO=0
# read-only account created by `dse demo seed` (see docs/hosting.md)
# Search Console "HTML tag" token, only to claim a public site there
APP_GOOGLE_SITE_VERIFICATION=
