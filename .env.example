# Copy this file to .env and fill in what you use. Everything is optional except
# where noted; the app works with no keys at all (console + file alerts only).

# --- storage -----------------------------------------------------------------
DSE_DATA_DIR=./data                 # DuckDB market data + SQLite app DB live here

# --- email delivery (optional; leave blank to keep alerts in the console/outbox) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=                          # e.g. yourname@gmail.com
SMTP_PASSWORD=                      # Gmail "App password" (not your login password)
ALERT_FROM=                         # usually the same as SMTP_USER
ALERT_TO=                           # default recipient; users can override in the UI

# --- Telegram (optional) -----------------------------------------------------
# @BotFather -> /newbot -> token. Message your bot once, then `dse alerts telegram-id`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                   # default chat; users can set their own in the web UI

# --- AI summary (optional) ---------------------------------------------------
# An ordered chain; the first provider that is configured and answers writes the summary.
# Leave every key blank and the feature is off. Names: groq, openrouter, anthropic, openai_compatible.
AI_PROVIDERS=groq,openrouter,anthropic
GROQ_API_KEY=                        # console.groq.com (free tier)
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=                  # openrouter.ai/keys (free models end in :free)
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
ANTHROPIC_API_KEY=                   # console.anthropic.com (paid)
ANTHROPIC_MODEL=claude-fable-5-1
# Any other OpenAI-compatible endpoint, e.g. a local Ollama (add "openai_compatible" to AI_PROVIDERS)
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=llama3.1

# --- web app -----------------------------------------------------------------
APP_SECRET_KEY=change-me            # required for the web UI sessions; any long random string
APP_HOST=127.0.0.1
APP_PORT=8000
APP_PUBLIC_URL=                     # e.g. https://dse-alerts.fly.dev when hosted; used in emails
APP_DEFAULT_LANG=en                 # en | bn; visitors and users can switch in the header
APP_DEMO=0                          # 1 on a public instance: "Try the demo" logs into the shared
                                    # read-only account created by `dse demo seed` (see docs/hosting.md)
